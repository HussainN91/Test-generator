.venv/
db.sqlite3
db.sqlite3-*
staticfiles/
__pycache__/
*.pyc
*.docx
bank-export*.json
.env

# Client's real diagnostic-test content (audio, images) - not app code,
# not for GitHub. The server gets this via a separate file copy, not git.
media/

# SSH keys - never belong in the repo, regardless of who pushes.
key.txt
key.txt.pub
Key.txt
Key.txt.pub
*.pem
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Server credentials and connection notes - plaintext password, never commit.
server push info.txt

# Local snapshot archives of the project folder. Hundreds of megabytes, and
# GitHub rejects any blob over 100 MB - a stray `git add -A` would stage one
# and fail the push after uploading it.
*.rar
*.zip
*.7z

# Scratch renders of a page, dropped in static/ only so a local dev server
# can display them. Never part of the app.
static/_preview*.html
